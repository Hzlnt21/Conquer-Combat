text = "CONTROLS\n\nA / D / W / S     Move & jump\nJ     Light attack\nK     Medium attack\nL     Heavy attack\nI     Special\nU     Covenant Guard\nO     Throw / Throw Tech\nP     Conquer Art / Burst / Shift\n[      Ultimate\n\nHold away from the opponent to block.\nPress Throw as an enemy throw reaches you to tech."

[node name="Systems" type="Label" parent="TutorialScreen/Panel/Content/Columns"]
custom_minimum_size = Vector2(430, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.86, 0.82, 0.88, 1)
theme_override_font_sizes/font_size = 15
text = "COMBAT SYSTEMS\n\nLIGHT > MEDIUM > HEAVY > SPECIAL\nBuild Conviction by fighting and advancing.\n\n1 BAR   Conquer Art or Shift Cancel\nBURST   Escape pressure once per round\n3 BARS  Ultimate Move\n\nIZUNA marks memories, then recalls them.\nXENON harvests emotion to summon despair."

